# Copy this file to terraform.tfvars and edit as needed.
#   cp terraform.tfvars.example terraform.tfvars
#
# Anything you don't set falls back to the default in variables.tf.
# NEVER commit terraform.tfvars (it is gitignored) — it can contain your IP / secrets.
#
# The Hetzner API token is NOT set here: export it as HCLOUD_TOKEN instead.

# --- Server ---------------------------------------------------------------------
# server_type = "cpx32"        # 4 vCPU / 8 GB RAM — smallest box that suits Ghidra
# location    = "nbg1"         # Nuremberg. fsn1 (Falkenstein) also works.
# server_name = "hacklab"
# image       = "ubuntu-26.04"

# --- Access ---------------------------------------------------------------------
# username             = "user"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"

# Restrict SSH to your own IP. Find it with: curl -s https://ifconfig.me
# STRONGLY recommended over the default of 0.0.0.0/0.
allowed_ssh_cidrs = ["0.0.0.0/0"]
# allowed_ssh_cidrs = ["203.0.113.7/32"]

# --- Ghidra ---------------------------------------------------------------------
# ghidra_version    = "12.1.4"
# ghidra_jdk_package = "openjdk-21-jdk"
